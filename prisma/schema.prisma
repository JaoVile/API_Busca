generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id           String   @id @default(uuid())
  companyName  String   @map("company_name")
  email        String   @unique
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  credentials TenantCredentials?
  reportLogs  ReportLog[]

  @@map("tenants")
}

model TenantCredentials {
  id                    String   @id @default(uuid())
  tenantId              String   @unique @map("tenant_id")
  providerTokenEncrypted  String   @map("provider_token_encrypted")
  quepasaTokenEncrypted String   @map("quepasa_token_encrypted")
  quepasaBaseUrl        String   @default("http://localhost:31000") @map("quepasa_base_url")
  whatsappNumber        String   @map("whatsapp_number")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_credentials")
}
