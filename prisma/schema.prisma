generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id           String   @id @default(uuid())
  companyName  String   @map("company_name")
  email        String   @unique
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  credentials TenantCredentials?
  reportLogs  ReportLog[]

  @@map("tenants")
}

model TenantCredentials {
  id                    String   @id @default(uuid())
  tenantId              String   @unique @map("tenant_id")
  providerTokenEncrypted  String   @map("provider_token_encrypted")
  providerUserEncrypted   String   @map("provider_user_encrypted")
  providerPassEncrypted   String   @map("provider_pass_encrypted")
  quepasaTokenEncrypted String   @map("quepasa_token_encrypted")
  quepasaBaseUrl        String   @default("http://localhost:31000") @map("quepasa_base_url")
  whatsappNumber        String   @map("whatsapp_number")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_credentials")
}

model ReportLog {
  id          String       @id @default(uuid())
  tenantId    String       @map("tenant_id")
  status      ReportStatus
  message     String?
  errorDetail String?      @map("error_detail")
  executedAt  DateTime     @default(now()) @map("executed_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("report_logs")
}

enum ReportStatus {
  SUCCESS
  PARTIAL_FAILURE
  FAILURE
}
